# Copy to .env.local for local dev. Never commit .env.local.

# Required to enable the ESV translation. Free key for personal /
# non-commercial use: https://api.esv.org/account/create-application/
ESV_API_KEY=

# Optional: enables much-higher-quality voice playback (Listen buttons).
# When set, the app proxies to Google Cloud Text-to-Speech for natural-
# sounding Telugu / Tamil / English voices. When unset, falls back to the
# browser's Web Speech API (mechanical OS voices).
#
# Setup (one-time):
#   1. console.cloud.google.com → new or existing project
#   2. Enable "Cloud Text-to-Speech API"
#   3. APIs & Services → Credentials → Create API key
#   4. Paste below
#
# Free tier: 1,000,000 chars/month for Chirp3-HD voices — enough for
# personal Bible reading.
GOOGLE_TTS_API_KEY=

# Optional: override which voice is used per language. Defaults to
# *-Chirp3-HD-Achernar (the most natural female voices Google offers).
# See https://cloud.google.com/text-to-speech/docs/voices for the full list.
# GOOGLE_TTS_VOICE_TE_IN=te-IN-Chirp3-HD-Achernar
# GOOGLE_TTS_VOICE_TA_IN=ta-IN-Chirp3-HD-Achernar
# GOOGLE_TTS_VOICE_EN_US=en-US-Chirp3-HD-Achernar
